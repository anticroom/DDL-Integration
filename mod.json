{
    "geode": "5.5.3",
    "gd": {
        "android": "2.2081",
        "win": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "version": "v1.4.1",
    "id": "anticroom.ddl-integration",
    "name": "DDL Integration",
    "developer": "anticroom",
    "description": "Simple DDL and DCL integration.",
    "resources": {
        "sprites": [ 
            "resources/*.png" 
        ]
    },
    "settings": {
        "enable-rank": {
            "name": "Enable Level Ranking Text",
            "description": "Whether or not to display the demon ranking text.",
            "type": "bool",
            "default": true
        },
        "white-rank": {
            "name": "White Level Ranking Text",
            "description": "Whether or not to display the level ranking text in white.",
            "type": "bool",
            "enable-if": "enable-rank",
            "default": false
        },
        "ddl-bg-color": {
            "name": "DDL Background Color",
            "description": "Sets the color of the background for the DDL.",
            "type": "color",
            "default": "#ff6ee7"
        },
        "dcl-bg-color": {
            "name": "DCL Background Color",
            "description": "Sets the color of the background for the DCL",
            "type": "color",
            "default": "#ba3fff"
        },
        "scroll-speed": {
            "name": "Scroll Speed",
            "description": "How fast the background pans.",
            "type": "int",
            "default": 15,
            "min": 5,
            "max": 30
        }
    },
    "dependencies": {
        "geode.node-ids": ">=v1.9.0"
    },
    "links": {
        "community": "https://discord.com/invite/denouement",
        "source": "https://github.com/anticroom/DDL-Integration",
        "homepage": "https://denouementdl.vercel.app"
    },
    "tags": [ 
        "content",
        "enhancement",
        "interface",
        "online",
        "utility" 
    ]
}